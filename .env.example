# --- Prism Server ---
PRISM_HOST=0.0.0.0
PRISM_PORT=9877
PRISM_API_KEY=                  # Legacy single-key auth (ignored when clients.json exists)

# --- Upstream (Company Model Proxy) ---
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=

# --- Model Mapping ---
DEFAULT_MODEL=

# --- Access Control ---
CLIENTS_FILE=clients.json       # Path to client registry JSON (see clients.example.json)

# --- Usage Tracking ---
USAGE_DB=prism_usage.db         # Path to SQLite usage database

# --- Admin API ---
PRISM_ADMIN_KEY=                # Admin API key (empty = admin endpoints disabled)
